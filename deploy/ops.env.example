# Copy to /etc/discussion-bot/ops.env (owner root, mode 600). Never commit the real file.
# Read by systemd (EnvironmentFile=) and by bash (`. ops.env`): double-quote any value that
# contains spaces, &, ;, #, $ or quotes.

# age public key for backups; keep the matching identity off the VM (password manager).
BACKUP_AGE_RECIPIENT="age1replace_with_your_public_key"
# Optional: command that copies each backup off-host; the file path is appended. Example:
# BACKUP_REMOTE_CMD="oci os object put --bucket-name discussion-backups --force --file"
BACKUP_REMOTE_CMD=""
# Optional: dead man's switch URL pinged after each successful backup.
BACKUP_PING_URL=""
# Discord webhook in the operator's private server for alerts.
OPS_WEBHOOK_URL=""
# Set once the web UI is published (M3) to watch the TLS certificate.
DOMAIN=""
