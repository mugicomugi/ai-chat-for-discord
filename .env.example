# Copy to .env. Use single quotes for secrets containing $ or #.
# Immutable bot image; scripts/deploy.sh updates it. On the production VM: the tag printed by
# scripts/build-image.sh (discord-discussion-bot:git-<commit>). A CI image pinned by digest also works.
BOT_IMAGE=discord-discussion-bot:git-replace_with_commit

DISCORD_TOKEN=your_discord_bot_token
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_MODEL=gpt-oss:120b

MARIADB_DATABASE=discussion
MARIADB_USER=discussion
MARIADB_PASSWORD=your_long_random_password
MARIADB_ROOT_PASSWORD=your_different_long_random_root_password

RETENTION_DAYS=30
REQUEST_TIMEOUT_SECONDS=180
RUST_LOG=discord_discussion_bot=info

# Web UI (Discord login and role settings; docs/runbook.md). Leave all three empty to keep it
# off; setting only some of them stops the bot at startup.
# DISCORD_CLIENT_ID: Developer Portal > OAuth2 > Client ID (same as the Application ID).
# DISCORD_CLIENT_SECRET: Developer Portal > OAuth2 > Client Secret.
# PUBLIC_BASE_URL: https://<DOMAIN> (no path). Register https://<DOMAIN>/auth/callback as a
# redirect URI in the Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_BASE_URL=
# Caddy (HTTPS) is started only with this profile; DOMAIN is the name it gets a certificate for.
#COMPOSE_PROFILES=web
DOMAIN=
# Only for cargo run on the host (Docker Compose fixes it to 0.0.0.0:8080 inside the container).
#WEB_BIND=127.0.0.1:8080
# Web chat: messages one user may send in 24 hours (protects the Ollama quota; 1-100000).
# Answers take REQUEST_TIMEOUT_SECONDS at most, like /talk.
#WEB_DAILY_MESSAGES_PER_USER=100

# Knowledge base (README "ナレッジベース", docs/runbook.md section 13). Empty = off. Providers in
# priority order, for example gemini,openai (ollama is possible once tests/live_embed.rs shows
# that https://ollama.com/api/embed works). Every listed provider needs its key, else the bot
# does not start. Ollama reuses OLLAMA_API_KEY and needs OLLAMA_EMBEDDING_MODEL.
EMBEDDING_PROVIDERS=
GEMINI_API_KEY=
#GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Background ingestion pace per provider. A "request" is one text (a batch of 32 counts as 32);
# tokens are estimated from characters. The Gemini defaults stay within its free tier
# (100 requests and 30,000 tokens a minute, 1,000 requests a day): raise them on a paid tier.
#GEMINI_EMBEDDING_REQUESTS_PER_MINUTE=50
#GEMINI_EMBEDDING_TOKENS_PER_MINUTE=20000
#GEMINI_EMBEDDING_REQUESTS_PER_DAY=800
#GEMINI_EMBEDDING_BATCH_SIZE=32
#OPENAI_EMBEDDING_REQUESTS_PER_MINUTE=500
#OPENAI_EMBEDDING_TOKENS_PER_MINUTE=200000
#OPENAI_EMBEDDING_REQUESTS_PER_DAY=0
#OPENAI_EMBEDDING_BATCH_SIZE=32
#OLLAMA_EMBEDDING_REQUESTS_PER_MINUTE=60
#OLLAMA_EMBEDDING_TOKENS_PER_MINUTE=30000
#OLLAMA_EMBEDDING_REQUESTS_PER_DAY=0
#OLLAMA_EMBEDDING_BATCH_SIZE=32
# Limits. KB_MAX_UPLOAD_BYTES is also Caddy's request body limit.
#KB_MAX_UPLOAD_BYTES=5242880
#KB_MAX_DOCS_PER_GUILD=50
#KB_MAX_CHUNKS_PER_GUILD=5000
#KB_MAX_CHUNKS_TOTAL=30000

# Only for cargo run on the host; Docker Compose overrides these.
DB_HOST=localhost
DB_PORT=3306
